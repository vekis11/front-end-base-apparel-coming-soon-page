{
  "name": "base-apparel-coming-soon",
  "version": "1.0.0",
  "description": "Base Apparel Coming Soon Page with Enterprise CI/CD",
  "main": "index.html",
  "scripts": {
    "start": "serve -s . -p 3000",
    "build": "echo 'Build completed'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "docker:build": "docker build -t base-apparel-frontend .",
    "docker:run": "docker run -p 3000:80 base-apparel-frontend",
    "docker:push": "docker tag base-apparel-frontend $DOCKER_REGISTRY/base-apparel-frontend:$BUILD_NUMBER && docker push $DOCKER_REGISTRY/base-apparel-frontend:$BUILD_NUMBER"
  },
  "keywords": [
    "frontend",
    "ci-cd",
    "aws",
    "docker",
    "kubernetes"
  ],
  "author": "Vekis Tem",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.50.0",
    "eslint-plugin-html": "^7.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "**/*.{js,html}",
      "!node_modules/**",
      "!coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
} 